# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore — nigdy go nie commituj.
# Wartości poniżej są PRZYKŁADOWE; wygeneruj własne:  python scripts/gen_secrets.py >> .env

# --- WMS API ---
# SQLite (dev) lub PostgreSQL (docker): postgresql+psycopg://wms:wms@db:5432/wms
DATABASE_URL=sqlite:///./var/wms.db
JWT_SECRET=zmien-mnie-na-losowy-ciag-min-32-znaki
JWT_TTL_MINUTES=480
APPROVAL_TTL_MINUTES=240
# Klienci usługowi (client_credentials). Scope'y są przypisane PO STRONIE WMS (wms/config.py), nie w żądaniu.
WMS_MCP_CLIENT_SECRET=zmien-mnie-sekret-mcp-wms
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Konta demo (opcjonalnie nadpisują domyślne z simulator/seed_users.py) ---
# DEMO_MANAGER_PASSWORD=
# DEMO_MANAGER_PIN=
# DEMO_OPERATOR_PASSWORD=

# --- mcp-wms ---
WMS_URL=http://localhost:8000
# Token, którym KLIENT MCP (orkiestrator / Claude Code) uwierzytelnia się wobec mcp-wms.
# Mapowanie token -> rola jest w config/policy.yaml (po nazwie zmiennej, nie wartości).
MCP_AGENT_TOKEN=zmien-mnie-token-agenta
MCP_READONLY_TOKEN=zmien-mnie-token-tylko-odczyt
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

# --- Orkiestrator / agent ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# AGENT_MODEL=claude-opus-5-5
AGENT_MAX_STEPS=40
AGENT_MAX_COST_USD=1.50

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
